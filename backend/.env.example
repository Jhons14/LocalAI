# =============================================================================
# LocalAI Chat API Environment Configuration
# =============================================================================
# Copy this file to .env.development or .env.production and customize as needed
# All values shown are defaults - uncomment and modify as required

# =============================================================================
# Application Settings
# =============================================================================
APP_NAME=LocalAI Chat API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# =============================================================================
# Server Configuration
# =============================================================================
HOST=0.0.0.0
PORT=8000
WORKERS=1
LOG_LEVEL=INFO

# =============================================================================
# CORS Settings (comma-separated origins)
# =============================================================================
CORS_ORIGINS=http://localhost:4321,http://localhost:3000,http://localhost:4322,http://127.0.0.1:4321,http://127.0.0.1:3000
CORS_CREDENTIALS=true

# =============================================================================
# Security Settings
# =============================================================================
SECURITY_SECRET_KEY=your-super-secret-key-change-me-in-production-must-be-32-chars-minimum
SECURITY_ALGORITHM=HS256
SECURITY_ACCESS_TOKEN_EXPIRE_MINUTES=30
SECURITY_MAX_LOGIN_ATTEMPTS=5
SECURITY_LOCKOUT_DURATION_MINUTES=15
SECURITY_RESET_TOKEN_EXPIRE_HOURS=6
SECURITY_MAX_RESET_ATTEMPTS_PER_HOUR=5

# =============================================================================
# Database Configuration
# =============================================================================
DB_URL=sqlite:///./app.db
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# =============================================================================
# Email Configuration (for password reset)
# =============================================================================
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=your-email@gmail.com
EMAIL_SMTP_PASSWORD=your-app-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_FROM_EMAIL=noreply@localai.app
EMAIL_FROM_NAME=LocalAI
EMAIL_BASE_URL=http://localhost:4321

# =============================================================================
# Rate Limiting (requests per minute)
# =============================================================================
RATE_LIMIT_CHAT_REQUESTS_PER_MINUTE=30
RATE_LIMIT_KEY_OPERATIONS_PER_MINUTE=10
RATE_LIMIT_MODEL_REQUESTS_PER_MINUTE=20

# =============================================================================
# LLM Provider Settings
# =============================================================================

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=30
OLLAMA_MAX_RETRIES=3

# OpenAI Configuration (API key provided per request for security)
OPENAI_TIMEOUT=30
OPENAI_MAX_TOKENS=4000
OPENAI_MAX_RETRIES=2

# =============================================================================
# Tool Integration
# =============================================================================
ARCADE_API_KEY=your-arcade-api-key-here
DEFAULT_TOOLKITS=Gmail,Slack,Calendar,Drive
MAX_TOOL_CALLS_PER_TURN=5
MAX_RECURSION_DEPTH=25

# =============================================================================
# Model Defaults
# =============================================================================
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=4000
DEFAULT_TIMEOUT=30

# =============================================================================
# Input Validation
# =============================================================================
MAX_PROMPT_LENGTH=10000
MAX_THREAD_ID_LENGTH=100

# =============================================================================
# Storage Paths
# =============================================================================
CONFIG_DIR=config
DATA_DIR=data
PREFERENCES_FILE=user_preferences.json
LOG_FILE=app.log